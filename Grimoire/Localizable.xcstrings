    "Rich, shadowy tales for anyone tired of silly stories. Courage, mystery, and worlds with rules of their own.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حكايات كثيفة ومظلمة لمن ملّ القصص السخيفة. شجاعة وغموض وعوالم لها قوانينها الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichte, düstere Erzählungen für alle, die alberne Geschichten satthaben. Mut, Geheimnis und Welten mit eigenen Regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich, shadowy tales for anyone tired of silly stories. Courage, mystery, and worlds with rules of their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatos densos y sombríos para quien se cansó de los cuentos bobos. Coraje, misterio y mundos con reglas propias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des récits denses et sombres pour qui en a assez des histoires niaises. Courage, mystère et mondes aux règles bien à eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racconti densi e cupi per chi è stanco delle storielle sciocche. Coraggio, mistero e mondi con regole proprie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contos densos e sombrios para quem cansou de historinhas bobas. Coragem, mistério e mundos com regras próprias."
          }
        }
      }
    },
