    "Every story you read moves your journey forward. Save your favorites, pick up where you left off, and unlock the whole grimoire.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل حكاية تقرؤها تمضي بمسارك قُدُماً. احفظ المفضّلة لديك، وتابع من حيث توقّفت، وافتح الكتاب كاملاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede gelesene Geschichte bringt dich weiter. Sichere deine Favoriten, lies dort weiter, wo du aufgehört hast, und schalte das ganze Grimoire frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every story you read moves your journey forward. Save your favorites, pick up where you left off, and unlock the whole grimoire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada historia leída avanza tu camino. Guarda tus favoritas, sigue donde lo dejaste y desbloquea el grimorio entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque histoire lue fait avancer votre chemin. Gardez vos favorites, reprenez où vous en étiez, et débloquez le grimoire entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni storia letta fa avanzare il tuo cammino. Salva le preferite, riprendi da dove eri rimasto e sblocca l'intero grimorio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
